<section class="scr" id="pause" role="dialog" aria-modal="true" aria-labelledby="pauseTitle">
    <div class="screen-content pause-content">
        <h2 id="pauseTitle">ПАУЗА</h2>
        <p id="pauseReason" role="status">Город подождёт.</p>
        <div class="stack-actions">
            <GameButton Id="resume" OnClick="OnResume">ПРОДОЛЖИТЬ</GameButton>
            <GameButton Id="pauseSettingsButton" Class="secondary" OnClick="OnSettings">НАСТРОЙКИ</GameButton>
            <GameButton Id="restart" Class="secondary" OnClick="OnRestart">НАЧАТЬ ЗАНОВО</GameButton>
            <GameButton Id="pauseToMenu" Class="text-button" OnClick="OnMenu">В ГЛАВНОЕ МЕНЮ</GameButton>
        </div>
        <p class="keyboard-hints screen-note"><kbd>Esc</kbd> — продолжить</p>
    </div>
</section>

@code {
    [Parameter] public EventCallback OnResume { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnSettings { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
}