<div id="hud">
    <div id="cross" aria-hidden="true"></div>
    <PlayerVitals />
    <AmmoReadout />
    <div id="obj"><span id="arrow" aria-hidden="true">▲</span><br /><span id="dist"></span></div>
    <canvas id="map" width="110" height="110" aria-label="Мини-карта"></canvas>
    <div id="boss"><div class="boss-name">DON VITTORIO CORVO</div><div class="bar"><i></i></div></div>
    <div id="msg" role="status"></div>
