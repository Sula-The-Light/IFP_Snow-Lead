    <GameButton Id="fullscreenButton" Class="game-button" Label="На весь экран" Title="На весь экран" OnClick="OnFullscreen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" /></svg></GameButton>
    <MissionReadout />
</div>

@code {
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnFullscreen { get; set; }
}