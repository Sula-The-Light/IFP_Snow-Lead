<div id="touch" aria-label="Сенсорное управление">
    <div id="lookZone" aria-hidden="true"></div>
    <div id="joystick" role="group" aria-label="Джойстик движения"><div id="stick"></div><span class="joystick-label">ДВИЖЕНИЕ</span></div>
    <button id="tf" type="button" aria-label="Стрелять; ведите пальцем для прицеливания">FIRE</button>
    <button id="tb" type="button" aria-label="Замедление времени" aria-pressed="false">SLOW</button>
    <button id="tr" type="button" aria-label="Перезарядить">RELOAD</button>
    <button id="ts" type="button" aria-label="Бежать" aria-pressed="false">SPRINT</button>
</div>